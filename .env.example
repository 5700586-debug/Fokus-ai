# ENVIRONMENT: "production" (standart, bo'sh qoldirilsa ham shu) yoki
# "test". "test" bo'lsa bot BOT_TOKEN/DATABASE_URL o'rniga pastdagi
# TEST_BOT_TOKEN/TEST_DATABASE_URL'ni o'qiydi — ikkalasi BUTUNLAY BOSHQA
# nomli o'zgaruvchi, shuning uchun bir xil faylda ikkalasi ham tursa ham
# production va test bir-biriga aralashib qolmaydi.
ENVIRONMENT=production

# Majburiy (production uchun) — bularsiz bot ishga tushmaydi.
BOT_TOKEN=123456:your-telegram-bot-token
OPENAI_API_KEY=sk-your-openai-api-key

# Faqat ENVIRONMENT=test bo'lganda o'qiladi (yuqoridagi BOT_TOKEN o'rniga).
# @BotFather'dan olingan ALOHIDA test bot tokeni shu yerga yoziladi —
# TOKENNI HECH QACHON CHATGA YOKI KODGA YOZMANG, faqat shu faylga (yoki
# Render'dagi test servisining Environment bo'limiga) qo'ying.
# TEST_BOT_TOKEN=

# Ixtiyoriy — qo'yilmasa SQLite (fokus.db, loyiha papkasida) ishlatiladi.
# Prod uchun Supabase Postgres Session Pooler manzili tavsiya etiladi.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Faqat ENVIRONMENT=test bo'lganda o'qiladi. Bo'sh qoldirilsa (tavsiya
# etiladi, agar alohida test Postgres schema hali yo'q bo'lsa) — test
# muhiti avtomatik ALOHIDA SQLite fayl (fokus_test.db) bilan ishlaydi,
# production bazasiga sira ulanmaydi. Agar kelajakda Supabase'da alohida
# test schema/baza ochilsa, uning connection string'i shu yerga yoziladi.
# TEST_DATABASE_URL=

# Ixtiyoriy — standart: Asia/Tashkent. Barcha "bugungi kun" hisob-kitoblari
# (smena, ombor, BOS baho/jarima, kalibratsiya) shu vaqt zonasi bo'yicha.
# COMPANY_TIMEZONE=Asia/Tashkent

# Ixtiyoriy — qo'yilmasa kodda yozilgan avvalgi Founder bilan ishlaydi.
# Founder almashtirish uchun shu yerga yangi Telegram user_id yoziladi.
# FOUNDER_ID=

# Ixtiyoriy — fokus.db/allowed_users.json qayerga yozilishini belgilaydi
# (masalan Render Persistent Disk yo'li). Qo'yilmasa loyiha papkasi.
# FOKUS_DATA_DIR=

# Ixtiyoriy — Render "Web Service" health-check porti. Render buni o'zi
# avtomatik beradi, lokal ishga tushirishda kerak emas.
# PORT=10000

# Ixtiyoriy — SMS/vision hali ulanmagan (har doim Null* stub qaytadi),
# shuning uchun bu flag/kalitlar hozircha real ta'sir qilmaydi.
# SMS_PROVIDER_ENABLED=false
# SMS_API_KEY=
# VISION_EXTRACTION_ENABLED=false
# VISION_EXTRACTION_API_KEY=

# Ixtiyoriy — Saturn guruh tonggi rasmidagi kichik ob-havo belgisi uchun.
# false (standart) bo'lsa ob-havo bloki butunlay ko'rsatilmaydi (xato
# emas). true qilinsa Open-Meteo (https://open-meteo.com) ishlatiladi —
# BEPUL va KALITSIZ, shuning uchun API kalit talab qilinmaydi.
# WEATHER_PROVIDER_ENABLED=false
# WEATHER_API_KEY=

# Ixtiyoriy — Saturn ob-havo belgisidagi shahar/koordinata. Open-Meteo
# shahar nomini emas, lat/lon so'raydi. Standart: Qo'qon.
# SATURN_WEATHER_CITY=Qo'qon
# SATURN_WEATHER_LAT=40.5286
# SATURN_WEATHER_LON=70.9425

# Ixtiyoriy — Saturn'ning ASL logotip fayli qo'shilganda shu yo'lga
# ko'rsatiladi (masalan "assets/logo/saturn_logo.png", shaffof PNG).
# Hozircha bunday fayl repoda yo'q — qo'yilmasa yoki fayl topilmasa,
# tonggi/tungi rasmda oddiy "SATURN" yozuvi ishlatiladi (soxta logotip
# o'ylab topilmaydi).
# SATURN_LOGO_PATH=

# Ixtiyoriy — standart: true. Saturn guruhiga hozircha faqat mehribon/
# foydali mazmun (moliyaviy ko'rsatkich, KPI tanqidi, jarima YO'Q)
# yuborilishini bildiradi ("Friendly phase"). Keyingi, qattiqroq nazorat
# bosqichi hali qurilmagan.
# SATURN_FRIENDLY_PHASE=true

# Saturn guruh chat_id'si, tonggi/tungi yuborish vaqti va yoqish/
# o'chirish — ENV VAR EMAS, Founder tomonidan botda /setrule orqali
# dinamik boshqariladi (qayta deploy shart emas):
#   /setrule saturn.group_chat_id <guruh_chat_id>   (yoki guruhda /saturntest)
#   /setrule saturn.morning_time 08:00
#   /setrule saturn.evening_time 21:00               (tungi rasm ham shu vaqtda)
#   /setrule saturn.morning_image_enabled 0           (o'chirish uchun)
#   /setrule saturn.night_image_enabled 0             (o'chirish uchun)
